
#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПутьExcelНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьФайл(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Кнопка "Загрузить контрагентов". Если файл еще не выбран, сначала открывается диалог выбора.
&НаКлиенте
Процедура Загрузить(Команда)

	Если ПустаяСтрока(ПутьExcel) Тогда
		ВыбратьФайл(Новый ОписаниеОповещения("ЗагрузитьВыбранныйФайл", ЭтотОбъект));
	Иначе
		ЗагрузитьВыбранныйФайл(Неопределено, Неопределено);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьФайл(ОповещениеПослеВыбора)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл Excel с контрагентами";
	Диалог.Фильтр = "Книги Excel (*.xlsx;*.xls)|*.xlsx;*.xls|Все файлы (*.*)|*.*";
	Если Не ПустаяСтрока(ПутьExcel) Тогда
		ТекущийФайл = Новый Файл(ПутьExcel);
		Диалог.Каталог = ТекущийФайл.Путь;
		Диалог.ПолноеИмяФайла = ТекущийФайл.Имя;
	КонецЕсли;
	Диалог.Показать(Новый ОписаниеОповещения("ВыборФайлаЗавершение", ЭтотОбъект, ОповещениеПослеВыбора));

КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаЗавершение(ВыбранныеФайлы, ОповещениеПослеВыбора) Экспорт

	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПутьExcel = ВыбранныеФайлы[0];
	Если ОповещениеПослеВыбора <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеПослеВыбора);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВыбранныйФайл(Результат, ДополнительныеПараметры) Экспорт

	Попытка
		Результат = ЗагрузитьExcelНаСервере();
	Исключение
		Сообщить("Файл не загружен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Для Каждого ТекстСообщения Из Результат.Сообщения Цикл
		Сообщить(ТекстСообщения);
	КонецЦикла;
	Сообщить(Результат.Итог);

	Если Результат.Дубли.Количество() > 0 Тогда
		ПоказатьПредупреждение(, "Контрагенты с такими ИНН уже есть в справочнике, повторно они не созданы:"
			+ Символы.ПС + СтрСоединить(Результат.Дубли, Символы.ПС), , "Найдены дубли по ИНН");
	КонецЕсли;

КонецПроцедуры

// Читает книгу Excel (лист 1: A - краткое наименование, B - полное наименование,
// C - вид контрагента, D - ИНН, E - КПП; первая строка - заголовки) и создает контрагентов.
// Если контрагент с таким ИНН уже есть, элемент не создается и выводится сообщение.
&НаСервере
Функция ЗагрузитьExcelНаСервере()

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Прочитать(ПутьExcel, СпособЧтенияЗначенийТабличногоДокумента.Значение);

	Создано = 0;
	Дубли = 0;
	Пропущено = 0;
	Протокол = Новый Массив;
	СписокДублей = Новый Массив;
	ИННВФайле = Новый Соответствие;

	Для НомерСтроки = 2 По ТабДок.ВысотаТаблицы Цикл

		Краткое = СокрЛП(ТабДок.Область(НомерСтроки, 1).Текст);
		Полное  = СокрЛП(ТабДок.Область(НомерСтроки, 2).Текст);
		Вид     = СокрЛП(ТабДок.Область(НомерСтроки, 3).Текст);
		ИНН     = ТолькоЦифры(ТабДок.Область(НомерСтроки, 4).Текст);
		КПП     = ТолькоЦифры(ТабДок.Область(НомерСтроки, 5).Текст);

		Если ПустаяСтрока(Краткое) И ПустаяСтрока(Полное) И ПустаяСтрока(ИНН) Тогда
			Продолжить; // пустая строка листа
		КонецЕсли;

		Если ПустаяСтрока(ИНН) Тогда
			Пропущено = Пропущено + 1;
			ДобавитьВПротокол(Протокол, "Пропущена строка " + НомерСтроки + ": не указан ИНН");
			Продолжить;
		КонецЕсли;

		Существующий = КонтрагентСИНН(ИНН);
		Если ЗначениеЗаполнено(Существующий) Тогда
			Дубли = Дубли + 1;
			ДобавитьВПротокол(Протокол, "Строка " + НомерСтроки + ": контрагент с ИНН " + ИНН
				+ " уже существует («" + Существующий + "»), новый элемент не создан");
			СписокДублей.Добавить("ИНН " + ИНН + " - «" + Существующий + "»");
			Продолжить;
		КонецЕсли;
		Если ИННВФайле[ИНН] <> Неопределено Тогда
			Дубли = Дубли + 1;
			ДобавитьВПротокол(Протокол, "Строка " + НомерСтроки + ": ИНН " + ИНН
				+ " повторяется в файле (строка " + ИННВФайле[ИНН] + "), новый элемент не создан");
			СписокДублей.Добавить("ИНН " + ИНН + " - повтор в файле");
			Продолжить;
		КонецЕсли;

		ВидКонтрагента = ВидКонтрагентаПоПредставлению(Вид);
		Если Не ЗначениеЗаполнено(ВидКонтрагента) Тогда
			ВидКонтрагента = Перечисления.ВидыКонтрагентов.ЮридическоеЛицо;
			ДобавитьВПротокол(Протокол, "Строка " + НомерСтроки + ": вид контрагента """ + Вид
				+ """ не распознан, установлено ""Юридическое лицо""");
		КонецЕсли;
		ЭтоЮрЛицо = (ВидКонтрагента = Перечисления.ВидыКонтрагентов.ЮридическоеЛицо
			Или ВидКонтрагента = Перечисления.ВидыКонтрагентов.ГосударственныйОрган);

		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("ВидКонтрагента", ВидКонтрагента);
		ДанныеЗаполнения.Вставить("ЮридическоеФизическоеЛицо", ?(ЭтоЮрЛицо,
			Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо,
			Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо));

		НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
		НовыйКонтрагент.Заполнить(ДанныеЗаполнения); // значения по умолчанию УНФ
		НовыйКонтрагент.Наименование = Краткое;
		НовыйКонтрагент.НаименованиеПолное = Полное;
		НовыйКонтрагент.ВидКонтрагента = ВидКонтрагента;
		НовыйКонтрагент.ЮридическоеФизическоеЛицо = ДанныеЗаполнения.ЮридическоеФизическоеЛицо;
		НовыйКонтрагент.ИНН = ИНН;
		Если ЭтоЮрЛицо Тогда
			НовыйКонтрагент.КПП = КПП;
		ИначеЕсли Не ПустаяСтрока(КПП) Тогда
			ДобавитьВПротокол(Протокол, "Строка " + НомерСтроки + ": КПП " + КПП
				+ " не заполнен - для вида """ + ВидКонтрагента + """ КПП не применяется");
		КонецЕсли;
		НовыйКонтрагент.Записать();

		ИННВФайле.Вставить(ИНН, НомерСтроки);
		Создано = Создано + 1;
		ДобавитьВПротокол(Протокол, "Строка " + НомерСтроки + ": создан контрагент «" + Краткое
			+ "» (" + ВидКонтрагента + ", ИНН " + ИНН + ")");

	КонецЦикла;

	Итог = "Создано: " + Создано + ", дублей по ИНН: " + Дубли + ", пропущено: " + Пропущено;
	РезультатИмпорта = Итог + Символы.ПС + СтрСоединить(Протокол, Символы.ПС);

	Возврат Новый Структура("Итог, Сообщения, Дубли", Итог, Протокол, СписокДублей);

КонецФункции

// Поиск дубликата по точному значению ИНН.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты - найденный контрагент или пустая ссылка.
//
&НаСервереБезКонтекста
Функция КонтрагентСИНН(ИНН)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И НЕ Контрагенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Сопоставляет текст из файла ("Юридическое лицо", "Индивидуальный предприниматель" и т.п.)
// со значением перечисления ВидыКонтрагентов по его синониму.
&НаСервереБезКонтекста
Функция ВидКонтрагентаПоПредставлению(Представление)

	Искомое = НРег(СтрЗаменить(Представление, " ", ""));
	Для Каждого Значение Из Метаданные.Перечисления.ВидыКонтрагентов.ЗначенияПеречисления Цикл
		Если НРег(СтрЗаменить(Значение.Синоним, " ", "")) = Искомое
			Или НРег(Значение.Имя) = Искомое Тогда
			Возврат Перечисления.ВидыКонтрагентов[Значение.Имя];
		КонецЕсли;
	КонецЦикла;

	Возврат Перечисления.ВидыКонтрагентов.ПустаяСсылка();

КонецФункции

// ИНН и КПП в Excel могут быть числами, поэтому оставляем только цифры
// (убираем разделители разрядов и пробелы).
&НаСервереБезКонтекста
Функция ТолькоЦифры(Текст)

	Результат = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Знак) > 0 Тогда
			Результат = Результат + Знак;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьВПротокол(Протокол, Текст)

	Протокол.Добавить(Текст);

КонецПроцедуры

#КонецОбласти
