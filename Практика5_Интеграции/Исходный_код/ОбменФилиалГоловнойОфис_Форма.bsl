
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.Роль.РежимВыбораИзСписка = Истина;
	Элементы.Роль.СписокВыбора.Добавить("Филиал", "Филиал");
	Элементы.Роль.СписокВыбора.Добавить("ГоловнойОфис", "Головной офис");

	Обработка = РеквизитФормыВЗначение("Объект");
	КаталогОбмена = Обработка.КаталогОбмена();
	Роль = Обработка.РольЭтойБазы();
	ЖурналОбмена = Обработка.ПрочитатьЖурнал();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодключитьОбработчикОжидания("ОбновитьЖурналАвтоматически", 15);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура АвтообменПриИзменении(Элемент)

	Если Автообмен Тогда
		Если ПустаяСтрока(Роль) Тогда
			Автообмен = Ложь;
			Сообщить("Укажите роль этой базы.");
			Возврат;
		КонецЕсли;
		ПодключитьОбработчикОжидания("ВыполнитьАвтообмен", 30);
	Иначе
		ОтключитьОбработчикОжидания("ВыполнитьАвтообмен");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОбменСейчас(Команда)

	Если ПустаяСтрока(Роль) Тогда
		Сообщить("Укажите роль этой базы: Филиал или Головной офис.");
		Возврат;
	КонецЕсли;

	ВыполнитьОбменНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЖурнал(Команда)

	ОбновитьЖурналНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыполнитьАвтообмен()

	ВыполнитьОбменНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЖурналАвтоматически()

	ОбновитьЖурналНаСервере();

КонецПроцедуры

&НаСервере
Процедура ВыполнитьОбменНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.СохранитьРольЭтойБазы(Роль);
	ПоследнийОбмен = Обработка.ВыполнитьОбмен(Роль);
	ЖурналОбмена = Обработка.ПрочитатьЖурнал();

КонецПроцедуры

&НаСервере
Процедура ОбновитьЖурналНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	ЖурналОбмена = Обработка.ПрочитатьЖурнал();

КонецПроцедуры

#КонецОбласти
