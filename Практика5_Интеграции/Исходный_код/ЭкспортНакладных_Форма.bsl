
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецПериода = КонецМесяца(ТекущаяДатаСеанса());
	ПутьФайла = "C:\Exchange\incoming.json";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПутьФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Файл для выгрузки приходных накладных";
	Диалог.Фильтр = "Файлы JSON (*.json)|*.json|Все файлы (*.*)|*.*";
	Если Не ПустаяСтрока(ПутьФайла) Тогда
		ТекущийФайл = Новый Файл(ПутьФайла);
		Диалог.Каталог = ТекущийФайл.Путь;
		Диалог.ПолноеИмяФайла = ТекущийФайл.Имя;
	КонецЕсли;
	Диалог.Показать(Новый ОписаниеОповещения("ПутьФайлаВыборЗавершение", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ПутьФайлаВыборЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		ПутьФайла = ВыбранныеФайлы[0];
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выгрузить(Команда)

	Если Не ЗначениеЗаполнено(НачалоПериода)
		Или Не ЗначениеЗаполнено(КонецПериода)
		Или ПустаяСтрока(ПутьФайла) Тогда
		Сообщить("Заполните период и путь к JSON-файлу.");
		Возврат;
	КонецЕсли;

	Если НачалоПериода > КонецПериода Тогда
		Сообщить("Начало периода больше конца.");
		Возврат;
	КонецЕсли;

	Количество = ВыгрузитьНаСервере();
	Сообщить("Выгружено накладных: " + Строка(Количество) + ". Файл: " + ПутьФайла);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выгружает приходные накладные за период в JSON-файл.
// Каждая накладная - объект JSON, ее строки "Товары" - вложенный массив внутри этого объекта,
// поэтому строки табличной части не перемешиваются между документами.
//
// Возвращаемое значение:
//  Число - количество выгруженных накладных.
//
&НаСервере
Функция ВыгрузитьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Накладная.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходнаяНакладная КАК Накладная
	|ГДЕ
	|	Накладная.Дата МЕЖДУ &Начало И &Конец
	|	И НЕ Накладная.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Накладная.Дата";
	Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
	Выборка = Запрос.Выполнить().Выбрать();

	РезультатJSON = Новый Массив;
	Пока Выборка.Следующий() Цикл

		Док = Выборка.Ссылка.ПолучитьОбъект();

		// В УНФ табличная часть с товарами называется "Запасы",
		// в файл она выгружается под универсальным ключом "Товары".
		СтрокиJSON = Новый Массив;
		Для Каждого СтрокаТовара Из Док.Запасы Цикл
			Позиция = Новый Структура;
			Позиция.Вставить("Номенклатура", ДокСтрокаИмя(СтрокаТовара.Номенклатура));
			Позиция.Вставить("Количество", СтрокаТовара.Количество);
			Позиция.Вставить("Сумма", СтрокаТовара.Сумма);
			СтрокиJSON.Добавить(Позиция);
		КонецЦикла;

		Данные = Новый Структура;
		Данные.Вставить("ДатаДокумента", XMLСтрока(Док.Дата));
		Данные.Вставить("Организация", ДокСтрокаИмя(Док.Организация));
		Данные.Вставить("Контрагент", ДокСтрокаИмя(Док.Контрагент));
		Данные.Вставить("Склад", ДокСтрокаИмя(Док.СтруктурнаяЕдиница));
		Данные.Вставить("Товары", СтрокиJSON);
		РезультатJSON.Добавить(Данные);

	КонецЦикла;

	ФайлВыгрузки = Новый Файл(ПутьФайла);
	КаталогВыгрузки = Новый Файл(ФайлВыгрузки.Путь);
	Если Не КаталогВыгрузки.Существует() Тогда
		СоздатьКаталог(ФайлВыгрузки.Путь);
	КонецЕсли;

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ПутьФайла, "UTF-8", Ложь, ПараметрыЗаписи);
	ЗаписатьJSON(Запись, РезультатJSON);
	Запись.Закрыть();

	// Показываем полученный файл на форме
	Чтение = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
	СодержимоеФайла = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат РезультатJSON.Количество();

КонецФункции

// Представление ссылочного реквизита: наименование элемента справочника
// или пустая строка, если значение не заполнено.
&НаСервереБезКонтекста
Функция ДокСтрокаИмя(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Значение.Наименование;

КонецФункции

#КонецОбласти
