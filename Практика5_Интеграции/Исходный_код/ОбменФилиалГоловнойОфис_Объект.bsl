#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Обмен данными между двумя базами УНФ через JSON-файлы в общем каталоге.
//
// Канал branch_to_head: Филиал -> Головной офис, новые и измененные документы.
// Канал head_to_branch: Головной офис -> Филиал, новые и измененные элементы номенклатуры.
//
// Новые и измененные объекты определяются сравнением ВерсияДанных с сохраненным снимком.
// Объекты сериализуются средствами XDTO (конфигурации баз одинаковые), идентификатором обмена
// служит уникальный идентификатор ссылки. Вместе с объектами передаются элементы справочников,
// на которые они ссылаются; в базе-получателе отсутствующие элементы сопоставляются по правилам
// (Контрагенты - по ИНН и КПП, остальные - по наименованию) или создаются.

#Область ПрограммныйИнтерфейс

// Сведения для регистрации в справочнике "Дополнительные отчеты и обработки" (БСП).
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Информация = "Обмен между базами УНФ ""Филиал"" и ""Головной офис"" через JSON-файлы в каталоге "
		+ КаталогОбмена() + ". Филиал отправляет документы, Головной офис - номенклатуру.";

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = "Обмен: Филиал (отправить документы, получить номенклатуру)";
	Команда.Идентификатор = "ОбменФилиал";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Истина;

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = "Обмен: Головной офис (отправить номенклатуру, получить документы)";
	Команда.Идентификатор = "ОбменГоловнойОфис";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Истина;

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = "Обмен Филиал - Головной офис (журнал и ручной запуск)";
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();

	Возврат ПараметрыРегистрации;

КонецФункции

// Вызывается БСП при выполнении серверной команды, в том числе регламентным заданием по расписанию.
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполнения = Неопределено) Экспорт

	Если ИдентификаторКоманды = "ОбменФилиал" Тогда
		ВыполнитьОбмен("Филиал");
	ИначеЕсли ИдентификаторКоманды = "ОбменГоловнойОфис" Тогда
		ВыполнитьОбмен("ГоловнойОфис");
	КонецЕсли;

КонецПроцедуры

// Выполняет один цикл обмена для базы с указанной ролью: сначала выгрузка, затем загрузка.
//
// Параметры:
//  Роль - Строка - "Филиал" или "ГоловнойОфис".
//
// Возвращаемое значение:
//  Строка - протокол цикла обмена.
//
Функция ВыполнитьОбмен(Роль) Экспорт

	Протокол = Новый Массив;

	Если Роль = "Филиал" Тогда
		КаналВыгрузки = "branch_to_head";
		КаналЗагрузки = "head_to_branch";
		ОбъектыВыгрузки = ДокументыФилиала();
	ИначеЕсли Роль = "ГоловнойОфис" Тогда
		КаналВыгрузки = "head_to_branch";
		КаналЗагрузки = "branch_to_head";
		ОбъектыВыгрузки = СтрРазделить("Справочник.Номенклатура", ",");
	Иначе
		ВызватьИсключение "Неизвестная роль базы: " + Роль;
	КонецЕсли;

	Попытка
		ПодготовитьКаталоги();
		Выгрузить(Роль, КаналВыгрузки, ОбъектыВыгрузки, Протокол);
	Исключение
		ЗаписатьВЖурнал(Роль, Протокол, "Выгрузка (" + КаналВыгрузки + ") не выполнена: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
	КонецПопытки;

	Попытка
		Загрузить(Роль, КаналЗагрузки, Протокол);
	Исключение
		ЗаписатьВЖурнал(Роль, Протокол, "Загрузка (" + КаналЗагрузки + ") не выполнена: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
	КонецПопытки;

	Возврат СтрСоединить(Протокол, Символы.ПС);

КонецФункции

// Общий каталог обмена, доступный обеим базам.
Функция КаталогОбмена() Экспорт

	Возврат "C:\UNFExchange";

КонецФункции

// Роль этой базы, сохраненная при последнем ручном запуске (по строке соединения).
Функция РольЭтойБазы() Экспорт

	Узлы = ПрочитатьСостояние("nodes");
	Если Узлы = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Роль = Узлы[СтрокаСоединенияИнформационнойБазы()];
	Возврат ?(Роль = Неопределено, "", Роль);

КонецФункции

Процедура СохранитьРольЭтойБазы(Роль) Экспорт

	ПодготовитьКаталоги();
	Узлы = ПрочитатьСостояние("nodes");
	Если Узлы = Неопределено Тогда
		Узлы = Новый Соответствие;
	КонецЕсли;
	Узлы.Вставить(СтрокаСоединенияИнформационнойБазы(), Роль);
	ЗаписатьСостояние("nodes", Узлы);

КонецПроцедуры

// Последние строки общего журнала обмена.
Функция ПрочитатьЖурнал(КоличествоСтрок = 60) Экспорт

	ИмяФайла = КаталогОбмена() + "\log\exchange.log";
	Файл = Новый Файл(ИмяФайла);
	Если Не Файл.Существует() Тогда
		Возврат "";
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Строки = СтрРазделить(Текст, Символы.ПС, Ложь);
	Последние = Новый Массив;
	Для Индекс = Макс(0, Строки.Количество() - КоличествоСтрок) По Строки.ВГраница() Цикл
		Последние.Добавить(Строки[Индекс]);
	КонецЦикла;
	Возврат СтрСоединить(Последние, Символы.ПС);

КонецФункции

#КонецОбласти

#Область Выгрузка

Функция ДокументыФилиала()

	Результат = Новый Массив;
	Имена = "ПриходнаяНакладная,РасходнаяНакладная,ЗаказПокупателя,ЗаказПоставщику,СчетНаОплату,"
		+ "ПоступлениеВКассу,РасходИзКассы,ПеремещениеЗапасов";
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Если Метаданные.Документы.Найти(Имя) <> Неопределено Тогда
			Результат.Добавить("Документ." + Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Выгружает новые и измененные с прошлого раза объекты в файл канала.
// При первом запуске только запоминает текущее состояние (начальная инициализация).
Процедура Выгрузить(Роль, Канал, ПолныеИмена, Протокол)

	ИмяСнимка = Роль + "_" + Канал + "_versions";
	Снимок = ПрочитатьСостояние(ИмяСнимка);

	Текущие = Новый Соответствие; // "ПолноеИмя|УИД" -> ВерсияДанных
	Ссылки = Новый Соответствие;  // "ПолноеИмя|УИД" -> Ссылка
	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Т.Ссылка КАК Ссылка,
			|	Т.ВерсияДанных КАК ВерсияДанных
			|ИЗ
			|	" + ПолноеИмя + " КАК Т");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Ключ = КлючСсылки(Выборка.Ссылка);
			Текущие.Вставить(Ключ, Выборка.ВерсияДанных);
			Ссылки.Вставить(Ключ, Выборка.Ссылка);
		КонецЦикла;
	КонецЦикла;

	Если Снимок = Неопределено Тогда
		ЗаписатьСостояние(ИмяСнимка, Текущие);
		ЗаписатьВЖурнал(Роль, Протокол, "Канал " + Канал + ": начальная инициализация, зафиксировано объектов: "
			+ Текущие.Количество() + ". Будут выгружаться объекты, созданные или измененные после этого момента.");
		Возврат;
	КонецЕсли;

	Измененные = Новый Массив;
	Для Каждого КлючИЗначение Из Текущие Цикл
		Если Снимок[КлючИЗначение.Ключ] <> КлючИЗначение.Значение Тогда
			Измененные.Добавить(Ссылки[КлючИЗначение.Ключ]);
		КонецЕсли;
	КонецЦикла;

	Если Измененные.Количество() = 0 Тогда
		Протокол.Добавить(ВремяСобытия() + " Канал " + Канал + ": новых и измененных объектов нет");
		Возврат;
	КонецЕсли;

	Пакет = Новый Структура;
	Пакет.Вставить("Формат", "UNFExchange/1.0");
	Пакет.Вставить("Канал", Канал);
	Пакет.Вставить("Отправитель", Роль);
	Пакет.Вставить("ИдентификаторСообщения", Строка(Новый УникальныйИдентификатор));
	Пакет.Вставить("ДатаСоздания", ТекущаяДатаСеанса());
	Пакет.Вставить("Объекты", Новый Массив);
	Пакет.Вставить("Зависимости", Новый Массив);

	Добавленные = Новый Соответствие;
	Представления = Новый Массив;
	Для Каждого Ссылка Из Измененные Цикл
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Пакет.Объекты.Добавить(Объект);
			Добавленные.Вставить(Ссылка, Истина);
			Представления.Добавить(Строка(Ссылка));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Объект Из Пакет.Объекты Цикл
		СобратьЗависимости(Объект, Пакет.Зависимости, Добавленные);
	КонецЦикла;

	ИмяФайла = Канал + "_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss") + "_"
		+ Лев(Пакет.ИдентификаторСообщения, 8) + ".json";
	КаталогВходящих = КаталогОбмена() + "\" + Канал + "\incoming\";
	ВременныйФайл = КаталогВходящих + ИмяФайла + ".tmp";

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ВременныйФайл, "UTF-8", Ложь, Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
	СериализаторXDTO.ЗаписатьJSON(Запись, Пакет, НазначениеТипаXML.Явное);
	Запись.Закрыть();
	// Получатель читает только *.json, поэтому недописанный файл он не увидит
	ПереместитьФайл(ВременныйФайл, КаталогВходящих + ИмяФайла);

	ЗаписатьСостояние(ИмяСнимка, Текущие);

	ЗаписатьВЖурнал(Роль, Протокол, "Канал " + Канал + ": выгружено в " + ИмяФайла + " объектов: "
		+ Пакет.Объекты.Количество() + ", связанных элементов справочников: " + Пакет.Зависимости.Количество()
		+ " (" + СтрСоединить(Представления, "; ") + ")");

КонецПроцедуры

// Добавляет в пакет элементы справочников, на которые ссылается объект (реквизиты, родитель,
// владелец, табличные части), чтобы получатель мог создать недостающие.
Процедура СобратьЗависимости(Объект, Зависимости, Добавленные)

	МетаданныеОбъекта = Объект.Метаданные();
	Значения = Новый Массив;

	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		Значения.Добавить(Объект[Реквизит.Имя]);
	КонецЦикла;
	Если ОбщегоНазначения.ЭтоСправочник(МетаданныеОбъекта) Тогда
		Если МетаданныеОбъекта.Иерархический Тогда
			Значения.Добавить(Объект.Родитель);
		КонецЕсли;
		Если МетаданныеОбъекта.Владельцы.Количество() > 0 Тогда
			Значения.Добавить(Объект.Владелец);
		КонецЕсли;
	КонецЕсли;
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		Для Каждого СтрокаТЧ Из Объект[ТабличнаяЧасть.Имя] Цикл
			Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
				Значения.Добавить(СтрокаТЧ[Реквизит.Имя]);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	ТипыСправочников = Справочники.ТипВсеСсылки();
	Для Каждого Значение Из Значения Цикл
		Если Не ЗначениеЗаполнено(Значение) Или Не ТипыСправочников.СодержитТип(ТипЗнч(Значение)) Тогда
			Продолжить;
		КонецЕсли;
		Если Добавленные[Значение] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Добавленные.Вставить(Значение, Истина);
		Если НеПередаватьСправочник(Значение.Метаданные().Имя) Тогда
			Продолжить;
		КонецЕсли;
		ОбъектЗависимости = Значение.ПолучитьОбъект();
		Если ОбъектЗависимости <> Неопределено Тогда
			Зависимости.Добавить(ОбъектЗависимости);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Служебные справочники, которые не передаются (пользователи, файлы, идентификаторы метаданных).
Функция НеПередаватьСправочник(Имя)

	Возврат СтрНайти(",Пользователи,ВнешниеПользователи,ГруппыПользователей,ИдентификаторыОбъектовМетаданных,"
		+ "ИдентификаторыОбъектовРасширений,", "," + Имя + ",") > 0
		Или СтрНайти(Имя, "ПрисоединенныеФайлы") > 0;

КонецФункции

#КонецОбласти

#Область Загрузка

// Загружает все входящие файлы канала в порядке их создания.
// Обработанные файлы переносятся в processed, ошибочные - в error.
Процедура Загрузить(Роль, Канал, Протокол)

	КаталогВходящих = КаталогОбмена() + "\" + Канал + "\incoming";
	Файлы = НайтиФайлы(КаталогВходящих, "*.json", Ложь);
	Если Файлы.Количество() = 0 Тогда
		Протокол.Добавить(ВремяСобытия() + " Канал " + Канал + ": входящих сообщений нет");
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Для Каждого Файл Из Файлы Цикл
		Список.Добавить(Файл.ПолноеИмя, Файл.Имя);
	КонецЦикла;
	Список.СортироватьПоПредставлению();

	ИмяПолученных = Роль + "_" + Канал + "_received";
	Полученные = ПрочитатьСостояние(ИмяПолученных);
	Если Полученные = Неопределено Тогда
		Полученные = Новый Соответствие;
	КонецЕсли;
	ИмяСоответствий = Роль + "_mapping";
	Соответствия = ПрочитатьСостояние(ИмяСоответствий);
	Если Соответствия = Неопределено Тогда
		Соответствия = Новый Соответствие;
	КонецЕсли;

	Для Каждого ЭлементСписка Из Список Цикл

		ПолноеИмяФайла = ЭлементСписка.Значение;
		ИмяФайла = ЭлементСписка.Представление;

		Попытка

			Пакет = ПрочитатьПакет(ПолноеИмяФайла);
			Если Пакет.Канал <> Канал Тогда
				ВызватьИсключение "Сообщение относится к каналу " + Пакет.Канал + ", ожидался " + Канал;
			КонецЕсли;

			Если Полученные[Пакет.ИдентификаторСообщения] <> Неопределено Тогда
				ПереместитьВАрхив(ПолноеИмяФайла, Канал, "processed");
				ЗаписатьВЖурнал(Роль, Протокол, "Канал " + Канал + ": сообщение " + ИмяФайла
					+ " уже было загружено ранее, повторно не обрабатывается");
				Продолжить;
			КонецЕсли;

			Итог = ЗагрузитьПакет(Пакет, Соответствия);

			Полученные.Вставить(Пакет.ИдентификаторСообщения, XMLСтрока(ТекущаяДатаСеанса()));
			ЗаписатьСостояние(ИмяПолученных, Полученные);
			ЗаписатьСостояние(ИмяСоответствий, Соответствия);
			ПереместитьВАрхив(ПолноеИмяФайла, Канал, "processed");
			ЗаписатьВЖурнал(Роль, Протокол, "Канал " + Канал + ": загружено сообщение " + ИмяФайла + ". " + Итог);

		Исключение

			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Попытка
				ПереместитьВАрхив(ПолноеИмяФайла, Канал, "error");
			Исключение
				ТекстОшибки = ТекстОшибки + " (файл не перемещен в error)";
			КонецПопытки;
			ЗаписатьВЖурнал(Роль, Протокол, "Канал " + Канал + ": сообщение " + ИмяФайла + " не загружено: "
				+ ТекстОшибки, Истина);

		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Функция ПрочитатьПакет(ПолноеИмяФайла)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ПолноеИмяФайла, "UTF-8");
	Попытка
		Пакет = СериализаторXDTO.ПрочитатьJSON(Чтение);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();

	Если ТипЗнч(Пакет) <> Тип("Структура")
		Или Не Пакет.Свойство("Объекты")
		Или Не Пакет.Свойство("Зависимости")
		Или Не Пакет.Свойство("ИдентификаторСообщения") Тогда
		ВызватьИсключение "Неверный формат сообщения обмена";
	КонецЕсли;

	Возврат Пакет;

КонецФункции

// Записывает объекты сообщения. Возвращает краткий итог.
Функция ЗагрузитьПакет(Пакет, Соответствия)

	Замены = Новый Соответствие; // ссылка из сообщения -> ссылка в этой базе
	Создано = 0;
	Обновлено = 0;
	Сопоставлено = 0;
	Подробности = Новый Массив;

	// 1. Связанные элементы справочников: существующие не изменяются, недостающие
	// сопоставляются по правилам или создаются с тем же уникальным идентификатором.
	Для Каждого Объект Из Пакет.Зависимости Цикл

		Ссылка = Объект.Ссылка;
		Локальная = ЛокальнаяСсылка(Ссылка, Соответствия);
		Если Локальная <> Неопределено Тогда
			Если Локальная <> Ссылка Тогда
				Замены.Вставить(Ссылка, Локальная);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Найденная = НайтиПоПравилам(Объект, Замены);
		Если Найденная <> Неопределено Тогда
			Замены.Вставить(Ссылка, Найденная);
			ЗапомнитьСоответствие(Соответствия, Ссылка, Найденная);
			Сопоставлено = Сопоставлено + 1;
			Подробности.Добавить("сопоставлен: " + Найденная);
			Продолжить;
		КонецЕсли;

		ЗаменитьСсылки(Объект, Замены);
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();
		Создано = Создано + 1;
		Подробности.Добавить("создан связанный элемент: " + Объект.Ссылка);

	КонецЦикла;

	// 2. Основные объекты сообщения: отсутствующие создаются, существующие обновляются.
	Для Каждого Объект Из Пакет.Объекты Цикл

		Ссылка = Объект.Ссылка;
		ЭтоДокумент = ОбщегоНазначения.ЭтоДокумент(Объект.Метаданные());
		Локальная = ЛокальнаяСсылка(Ссылка, Соответствия);

		Если Локальная = Неопределено И Не ЭтоДокумент Тогда
			Найденная = НайтиПоПравилам(Объект, Замены);
			Если Найденная <> Неопределено Тогда
				ЗапомнитьСоответствие(Соответствия, Ссылка, Найденная);
				Сопоставлено = Сопоставлено + 1;
				Подробности.Добавить("сопоставлен с существующим: " + Найденная);
				Продолжить;
			КонецЕсли;
		ИначеЕсли Локальная <> Неопределено И Локальная <> Ссылка Тогда
			Подробности.Добавить("уже сопоставлен ранее: " + Локальная);
			Продолжить;
		КонецЕсли;

		Существует = (Локальная <> Неопределено);
		ЗаменитьСсылки(Объект, Замены);

		Если ЭтоДокумент Тогда
			Состояние = ЗаписатьДокумент(Объект, Существует);
		Иначе
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
			Состояние = "";
		КонецЕсли;

		Если Существует Тогда
			Обновлено = Обновлено + 1;
			Подробности.Добавить("обновлен: " + Объект.Ссылка + Состояние);
		Иначе
			Создано = Создано + 1;
			Подробности.Добавить("создан: " + Объект.Ссылка + Состояние);
		КонецЕсли;

	КонецЦикла;

	Возврат "Создано: " + Создано + ", обновлено: " + Обновлено + ", сопоставлено: " + Сопоставлено
		+ ?(Подробности.Количество() > 0, " (" + СтрСоединить(Подробности, "; ") + ")", "");

КонецФункции

// Документ записывается в режиме загрузки, затем, если он был проведен в источнике,
// проводится в этой базе обычным образом (формируются движения).
Функция ЗаписатьДокумент(Объект, Существует)

	Ссылка = Объект.Ссылка;
	Если Существует Тогда
		ОтменитьПроведение(Ссылка);
	КонецЕсли;

	ПроведенВИсточнике = Объект.Проведен;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();

	Если Не ПроведенВИсточнике Тогда
		Возврат ", не проведен";
	КонецЕсли;

	Попытка
		ДокументОбъект = Ссылка.ПолучитьОбъект();
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Возврат ", проведен";
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОтменитьПроведение(Ссылка);
		Возврат ", записан без проведения: " + ТекстОшибки;
	КонецПопытки;

КонецФункции

Процедура ОтменитьПроведение(Ссылка)

	Попытка
		ДокументОбъект = Ссылка.ПолучитьОбъект();
		Если ДокументОбъект <> Неопределено И ДокументОбъект.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
	Исключение
		// Документ останется в прежнем состоянии; ошибка проведения уже попадет в протокол
	КонецПопытки;

КонецПроцедуры

// Ссылка в этой базе для ссылки из сообщения: по таблице соответствий или по тому же
// уникальному идентификатору. Неопределено, если объекта в этой базе нет.
Функция ЛокальнаяСсылка(Ссылка, Соответствия)

	Идентификатор = Соответствия[КлючСсылки(Ссылка)];
	Если Идентификатор <> Неопределено Тогда
		Менеджер = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Ссылка);
		Локальная = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
		Если ОбщегоНазначения.СсылкаСуществует(Локальная) Тогда
			Возврат Локальная;
		КонецЕсли;
	КонецЕсли;

	Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Правила сопоставления: Контрагенты - по ИНН и КПП, остальные справочники - по наименованию
// (подчиненные - в пределах владельца). Сопоставление выполняется только при единственном совпадении.
Функция НайтиПоПравилам(Объект, Замены)

	МетаданныеОбъекта = Объект.Метаданные();
	Если Не ОбщегоНазначения.ЭтоСправочник(МетаданныеОбъекта) Или МетаданныеОбъекта.ДлинаНаименования = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Условия.Добавить("НЕ Т.ПометкаУдаления");

	Если МетаданныеОбъекта.Имя = "Контрагенты" И ЗначениеЗаполнено(Объект.ИНН) Тогда
		Условия.Добавить("Т.ИНН = &ИНН");
		Условия.Добавить("Т.КПП = &КПП");
		Запрос.УстановитьПараметр("ИНН", Объект.ИНН);
		Запрос.УстановитьПараметр("КПП", Объект.КПП);
	Иначе
		Условия.Добавить("Т.Наименование = &Наименование");
		Запрос.УстановитьПараметр("Наименование", Объект.Наименование);
	КонецЕсли;

	Если МетаданныеОбъекта.Иерархический
		И МетаданныеОбъекта.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Условия.Добавить("Т.ЭтоГруппа = &ЭтоГруппа");
		Запрос.УстановитьПараметр("ЭтоГруппа", Объект.ЭтоГруппа);
	КонецЕсли;
	Если МетаданныеОбъекта.Владельцы.Количество() > 0 Тогда
		Владелец = Замены[Объект.Владелец];
		Условия.Добавить("Т.Владелец = &Владелец");
		Запрос.УстановитьПараметр("Владелец", ?(Владелец = Неопределено, Объект.Владелец, Владелец));
	КонецЕсли;

	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 2 Т.Ссылка КАК Ссылка ИЗ " + МетаданныеОбъекта.ПолноеИмя()
		+ " КАК Т ГДЕ " + СтрСоединить(Условия, " И ");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выборка.Следующий();
	Возврат Выборка.Ссылка;

КонецФункции

Процедура ЗапомнитьСоответствие(Соответствия, ВнешняяСсылка, ЛокальнаяСсылка)

	Соответствия.Вставить(КлючСсылки(ВнешняяСсылка), Строка(ЛокальнаяСсылка.УникальныйИдентификатор()));

КонецПроцедуры

// Заменяет в объекте ссылки из сообщения на сопоставленные ссылки этой базы.
Процедура ЗаменитьСсылки(Объект, Замены)

	Если Замены.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МетаданныеОбъекта = Объект.Метаданные();
	Имена = Новый Массив;
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		Имена.Добавить(Реквизит.Имя);
	КонецЦикла;
	Если ОбщегоНазначения.ЭтоСправочник(МетаданныеОбъекта) Тогда
		Если МетаданныеОбъекта.Иерархический Тогда
			Имена.Добавить("Родитель");
		КонецЕсли;
		Если МетаданныеОбъекта.Владельцы.Количество() > 0 Тогда
			Имена.Добавить("Владелец");
		КонецЕсли;
	КонецЕсли;
	Для Каждого Имя Из Имена Цикл
		НовоеЗначение = Замены[Объект[Имя]];
		Если НовоеЗначение <> Неопределено Тогда
			Объект[Имя] = НовоеЗначение;
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		Для Каждого СтрокаТЧ Из Объект[ТабличнаяЧасть.Имя] Цикл
			Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
				НовоеЗначение = Замены[СтрокаТЧ[Реквизит.Имя]];
				Если НовоеЗначение <> Неопределено Тогда
					СтрокаТЧ[Реквизит.Имя] = НовоеЗначение;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ФайлыИЖурнал

Процедура ПодготовитьКаталоги()

	Каталоги = Новый Массив;
	Для Каждого Канал Из СтрРазделить("branch_to_head,head_to_branch", ",") Цикл
		Для Каждого Подкаталог Из СтрРазделить("incoming,processed,error", ",") Цикл
			Каталоги.Добавить(КаталогОбмена() + "\" + Канал + "\" + Подкаталог);
		КонецЦикла;
	КонецЦикла;
	Каталоги.Добавить(КаталогОбмена() + "\state");
	Каталоги.Добавить(КаталогОбмена() + "\log");

	Для Каждого ИмяКаталога Из Каталоги Цикл
		Каталог = Новый Файл(ИмяКаталога);
		Если Не Каталог.Существует() Тогда
			СоздатьКаталог(ИмяКаталога);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПереместитьВАрхив(ПолноеИмяФайла, Канал, Подкаталог)

	Файл = Новый Файл(ПолноеИмяФайла);
	ИмяВАрхиве = КаталогОбмена() + "\" + Канал + "\" + Подкаталог + "\" + Файл.Имя;
	ФайлВАрхиве = Новый Файл(ИмяВАрхиве);
	Если ФайлВАрхиве.Существует() Тогда
		УдалитьФайлы(ИмяВАрхиве);
	КонецЕсли;
	ПереместитьФайл(ПолноеИмяФайла, ИмяВАрхиве);

КонецПроцедуры

Функция ПрочитатьСостояние(Имя)

	ИмяФайла = КаталогОбмена() + "\state\" + Имя + ".json";
	Файл = Новый Файл(ИмяФайла);
	Если Не Файл.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ИмяФайла, "UTF-8");
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;

КонецФункции

Процедура ЗаписатьСостояние(Имя, Данные)

	ИмяФайла = КаталогОбмена() + "\state\" + Имя + ".json";
	ВременныйФайл = ИмяФайла + ".tmp";

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ВременныйФайл, "UTF-8", Ложь, Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
	ЗаписатьJSON(Запись, Данные);
	Запись.Закрыть();

	Файл = Новый Файл(ИмяФайла);
	Если Файл.Существует() Тогда
		УдалитьФайлы(ИмяФайла);
	КонецЕсли;
	ПереместитьФайл(ВременныйФайл, ИмяФайла);

КонецПроцедуры

// Пишет событие в общий журнал C:\UNFExchange\log\exchange.log, в журнал регистрации и в протокол.
Процедура ЗаписатьВЖурнал(Роль, Протокол, Текст, ЭтоОшибка = Ложь)

	СтрокаЖурнала = ВремяСобытия() + " [" + Роль + "] " + ?(ЭтоОшибка, "ОШИБКА: ", "") + Текст;
	Протокол.Добавить(СтрокаЖурнала);

	Попытка
		Запись = Новый ЗаписьТекста(КаталогОбмена() + "\log\exchange.log", КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку(СтрокаЖурнала);
		Запись.Закрыть();
	Исключение
		// Каталог обмена недоступен - событие останется в журнале регистрации
	КонецПопытки;

	ЗаписьЖурналаРегистрации("Обмен Филиал - Головной офис",
		?(ЭтоОшибка, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация), , , СтрокаЖурнала);

КонецПроцедуры

Функция ВремяСобытия()

	Возврат Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'");

КонецФункции

Функция КлючСсылки(Ссылка)

	Возврат Ссылка.Метаданные().ПолноеИмя() + "|" + Строка(Ссылка.УникальныйИдентификатор());

КонецФункции

#КонецОбласти

#КонецЕсли
