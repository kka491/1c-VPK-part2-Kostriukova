
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресURL = "http://localhost:3000/Test/";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Кнопка "GET": прямой GET-запрос по адресу из поля URL.
&НаКлиенте
Процедура ВыполнитьGET(Команда)

	Если ПустаяСтрока(АдресURL) Тогда
		Сообщить("Введите URL-адрес.");
		Возврат;
	КонецЕсли;

	ВыполнитьGETНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьGETНаСервере()

	КодСостояния = 0;
	ВремяОтвета = 0;
	Заголовки = "";
	ТелоОтвета = "";

	Попытка

		Адрес = РазобратьURL(АдресURL);
		Если Адрес.Схема = "https" Тогда
			Защищенное = Новый ЗащищенноеСоединениеOpenSSL();
		Иначе
			Защищенное = Неопределено;
		КонецЕсли;

		Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , , 30, Защищенное);
		Запрос = Новый HTTPЗапрос(Адрес.ПутьИПараметры);

		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Ответ = Соединение.Получить(Запрос);
		ВремяОтвета = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

		КодСостояния = Ответ.КодСостояния;

		СтрокиЗаголовков = Новый Массив;
		ТипСодержимого = "";
		// Имя "Заголовок" в модуле формы занято свойством формы, поэтому переменная называется иначе
		Для Каждого ЗаголовокОтвета Из Ответ.Заголовки Цикл
			СтрокиЗаголовков.Добавить(ЗаголовокОтвета.Ключ + ": " + ЗаголовокОтвета.Значение);
			Если НРег(ЗаголовокОтвета.Ключ) = "content-type" Тогда
				ТипСодержимого = НРег(ЗаголовокОтвета.Значение);
			КонецЕсли;
		КонецЦикла;
		Заголовки = СтрСоединить(СтрокиЗаголовков, Символы.ПС);

		Если СтрНайти(ТипСодержимого, "charset") > 0 Тогда
			Тело = Ответ.ПолучитьТелоКакСтроку();
		Иначе
			Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");
		КонецЕсли;
		Если Тело = Неопределено Тогда
			Тело = "";
		КонецЕсли;

		Если СтрНайти(ТипСодержимого, "json") > 0 Тогда
			ТелоОтвета = ОтформатироватьJSON(Тело);
		Иначе
			ТелоОтвета = Тело;
		КонецЕсли;

	Исключение
		ТелоОтвета = "Ошибка выполнения запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщить(ТелоОтвета);
	КонецПопытки;

КонецПроцедуры

// Разбирает URL вида схема://хост:порт/путь?параметры на части для HTTPСоединение и HTTPЗапрос.
&НаСервереБезКонтекста
Функция РазобратьURL(Знач СтрокаURL)

	СтрокаURL = СокрЛП(СтрокаURL);
	Результат = Новый Структура("Схема, Хост, Порт, ПутьИПараметры", "http", "", 0, "/");

	Позиция = СтрНайти(СтрокаURL, "://");
	Если Позиция > 0 Тогда
		Результат.Схема = НРег(Лев(СтрокаURL, Позиция - 1));
		СтрокаURL = Сред(СтрокаURL, Позиция + 3);
	КонецЕсли;
	Если Результат.Схема <> "http" И Результат.Схема <> "https" Тогда
		ВызватьИсключение "Поддерживаются только адреса http:// и https://";
	КонецЕсли;

	// Отбрасываем фрагмент (#...): он не передается на сервер
	Позиция = СтрНайти(СтрокаURL, "#");
	Если Позиция > 0 Тогда
		СтрокаURL = Лев(СтрокаURL, Позиция - 1);
	КонецЕсли;

	// Хост и порт - до первого "/" или "?"
	КонецХоста = СтрДлина(СтрокаURL) + 1;
	Для Каждого Разделитель Из СтрРазделить("/,?", ",") Цикл
		Позиция = СтрНайти(СтрокаURL, Разделитель);
		Если Позиция > 0 И Позиция < КонецХоста Тогда
			КонецХоста = Позиция;
		КонецЕсли;
	КонецЦикла;
	ХостИПорт = Лев(СтрокаURL, КонецХоста - 1);
	Путь = Сред(СтрокаURL, КонецХоста);
	Если ПустаяСтрока(Путь) Тогда
		Путь = "/";
	ИначеЕсли Лев(Путь, 1) = "?" Тогда
		Путь = "/" + Путь;
	КонецЕсли;
	Результат.ПутьИПараметры = Путь;

	// Учетные данные вида user:password@host не используются
	Позиция = СтрНайти(ХостИПорт, "@");
	Если Позиция > 0 Тогда
		ХостИПорт = Сред(ХостИПорт, Позиция + 1);
	КонецЕсли;

	Позиция = СтрНайти(ХостИПорт, ":", НаправлениеПоиска.СКонца);
	Если Позиция > 0 И СтрНайти(ХостИПорт, "]") < Позиция Тогда
		Результат.Хост = Лев(ХостИПорт, Позиция - 1);
		Результат.Порт = Число(Сред(ХостИПорт, Позиция + 1));
	Иначе
		Результат.Хост = ХостИПорт;
		Результат.Порт = ?(Результат.Схема = "https", 443, 80);
	КонецЕсли;

	Если ПустаяСтрока(Результат.Хост) Тогда
		ВызватьИсключение "В URL не указан хост";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Переформатирует JSON с отступами для удобного чтения; если текст не JSON, возвращает его без изменений.
&НаСервереБезКонтекста
Функция ОтформатироватьJSON(Текст)

	// Структура сохраняет порядок ключей, но не принимает ключи, недопустимые как имена;
	// для таких ответов читаем в Соответствие
	Для Каждого ВСоответствие Из СтрРазделить("0,1", ",") Цикл
		Попытка
			Значение = ПрочитатьТекстJSON(Текст, ВСоответствие = "1");
			Запись = Новый ЗаписьJSON;
			Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  "));
			ЗаписатьJSON(Запись, Значение);
			Возврат Запись.Закрыть();
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	Возврат Текст;

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьТекстJSON(Текст, ВСоответствие)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Значение = ПрочитатьJSON(Чтение, ВСоответствие);
	Чтение.Закрыть();
	Возврат Значение;

КонецФункции

#КонецОбласти
