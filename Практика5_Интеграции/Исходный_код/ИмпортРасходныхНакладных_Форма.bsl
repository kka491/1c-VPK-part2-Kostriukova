
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПутьJSON = "C:\Exchange\incoming.json";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПутьJSONНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьФайл(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Кнопка "Загрузить JSON": выбор файла и загрузка его содержимого в обработку.
&НаКлиенте
Процедура Загрузить(Команда)

	ВыбратьФайл(Новый ОписаниеОповещения("ЗагрузитьВыбранныйФайл", ЭтотОбъект));

КонецПроцедуры

// Кнопка "Создать накладные": создание расходных накладных по загруженному файлу.
&НаКлиенте
Процедура Создать(Команда)

	Если ПустаяСтрока(ТекстJSON) Тогда
		Сообщить("Загрузите JSON-файл кнопкой ""Загрузить JSON"" (после создания документов файл загружается заново).");
		Возврат;
	КонецЕсли;

	СоздатьДокументыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьФайл(ОповещениеПослеВыбора)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите JSON-файл с накладными";
	Диалог.Фильтр = "Файлы JSON (*.json)|*.json|Все файлы (*.*)|*.*";
	Если Не ПустаяСтрока(ПутьJSON) Тогда
		ТекущийФайл = Новый Файл(ПутьJSON);
		Диалог.Каталог = ТекущийФайл.Путь;
		Диалог.ПолноеИмяФайла = ТекущийФайл.Имя;
	КонецЕсли;
	Диалог.Показать(Новый ОписаниеОповещения("ВыборФайлаЗавершение", ЭтотОбъект, ОповещениеПослеВыбора));

КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаЗавершение(ВыбранныеФайлы, ОповещениеПослеВыбора) Экспорт

	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПутьJSON = ВыбранныеФайлы[0];
	Если ОповещениеПослеВыбора <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеПослеВыбора);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВыбранныйФайл(Результат, ДополнительныеПараметры) Экспорт

	Попытка
		ЗагрузитьНаСервере();
	Исключение
		Сообщить("Файл не загружен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Сообщить("Документов в файле: " + Строка(ЧислоЗаписей));

КонецПроцедуры

// Читает файл, проверяет структуру JSON и показывает накладные на форме.
&НаСервере
Процедура ЗагрузитьНаСервере()

	ТекстJSON = "";
	ЧислоЗаписей = 0;
	СписокНакладных.Очистить();
	ТекстСообщения = "";

	Чтение = Новый ЧтениеТекста(ПутьJSON, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Накладные = ПрочитатьНакладныеИзJSON(Текст);

	ТекстJSON = Текст;
	ЧислоЗаписей = Накладные.Количество();
	Для Каждого ИсходныйДок Из Накладные Цикл
		НоваяСтрока = СписокНакладных.Добавить();
		НоваяСтрока.Дата = XMLЗначение(Тип("Дата"), ИсходныйДок.ДатаДокумента);
		НоваяСтрока.Организация = ИсходныйДок.Организация;
		НоваяСтрока.Контрагент = ИсходныйДок.Контрагент;
		НоваяСтрока.Склад = ИсходныйДок.Склад;
		НоваяСтрока.Позиций = ИсходныйДок.Товары.Количество();
		Для Каждого Позиция Из ИсходныйДок.Товары Цикл
			НоваяСтрока.Сумма = НоваяСтрока.Сумма + Позиция.Сумма;
		КонецЦикла;
		НоваяСтрока.Результат = "загружена";
	КонецЦикла;
	ТекстСообщения = "Загружен файл " + ПутьJSON + ". Документов в файле: " + ЧислоЗаписей + ".";

КонецПроцедуры

// Разбирает текст JSON и проверяет его структуру.
//
// Возвращаемое значение:
//  Массив из Структура - накладные с ключами ДатаДокумента, Организация, Контрагент, Склад, Товары.
//
&НаСервереБезКонтекста
Функция ПрочитатьНакладныеИзJSON(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		ВызватьИсключение "Корень JSON должен быть массивом.";
	КонецЕсли;

	ОбязательныеКлючи = СтрРазделить("ДатаДокумента,Организация,Контрагент,Склад,Товары", ",");
	КлючиСтроки = СтрРазделить("Номенклатура,Количество,Сумма", ",");

	Для Каждого ОбъектJSON Из Данные Цикл

		Если ТипЗнч(ОбъектJSON) <> Тип("Структура") Тогда
			ВызватьИсключение "Элемент массива - не объект.";
		КонецЕсли;

		Для Каждого Ключ Из ОбязательныеКлючи Цикл
			Если Не ОбъектJSON.Свойство(Ключ) Тогда
				ВызватьИсключение "В накладной нет обязательного ключа """ + Ключ + """.";
			КонецЕсли;
		КонецЦикла;

		ТоварыJSON = Неопределено;
		Если Не ОбъектJSON.Свойство("Товары", ТоварыJSON)
			Или ТипЗнч(ТоварыJSON) <> Тип("Массив") Тогда
			ВызватьИсключение "Нет массива Товары.";
		КонецЕсли;

		Для Каждого Позиция Из ТоварыJSON Цикл
			Для Каждого Ключ Из КлючиСтроки Цикл
				Если ТипЗнч(Позиция) <> Тип("Структура") Или Не Позиция.Свойство(Ключ) Тогда
					ВызватьИсключение "В строке товаров нет ключа """ + Ключ + """.";
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

	КонецЦикла;

	Возврат Данные;

КонецФункции

// Создает расходные накладные. Сначала проверяются все ссылки по всем документам;
// если хотя бы одна не найдена или неоднозначна, не создается ни один документ.
&НаСервере
Процедура СоздатьДокументыНаСервере()

	Накладные = ПрочитатьНакладныеИзJSON(ТекстJSON);

	// 1. Сопоставление по наименованиям и предварительная проверка
	Найденные = Новый Соответствие;
	Ошибки = Новый Массив;
	Для Каждого ИсходныйДок Из Накладные Цикл
		НайтиПоНаименованию("Организации", ИсходныйДок.Организация, Найденные, Ошибки);
		НайтиПоНаименованию("Контрагенты", ИсходныйДок.Контрагент, Найденные, Ошибки);
		НайтиПоНаименованию("СтруктурныеЕдиницы", ИсходныйДок.Склад, Найденные, Ошибки);
		Для Каждого Позиция Из ИсходныйДок.Товары Цикл
			НайтиПоНаименованию("Номенклатура", Позиция.Номенклатура, Найденные, Ошибки);
		КонецЦикла;
	КонецЦикла;

	Если Ошибки.Количество() > 0 Тогда
		Для Каждого ТекстОшибки Из Ошибки Цикл
			Сообщить(ТекстОшибки);
		КонецЦикла;
		ТекстСообщения = "Документы не созданы. Ошибки сопоставления:" + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
		Возврат;
	КонецЕсли;

	// 2. Создание документов в одной транзакции
	Протокол = Новый Массив;
	НачатьТранзакцию();
	Попытка
		Для Индекс = 0 По Накладные.ВГраница() Цикл
			Док = НоваяРасходнаяНакладная(Накладные[Индекс], Найденные);
			Док.Записать(РежимЗаписиДокумента.Запись); // без проведения
			ТекстРезультата = "создана № " + Док.Номер + " от " + Формат(Док.Дата, "ДЛФ=D") + ", не проведена";
			СписокНакладных[Индекс].Результат = ТекстРезультата;
			Протокол.Добавить("Расходная накладная № " + Док.Номер + " от " + Формат(Док.Дата, "ДЛФ=D")
				+ ": " + Док.Контрагент + ", строк " + Док.Запасы.Количество()
				+ ", сумма " + Формат(Док.СуммаДокумента, "ЧДЦ=2; ЧН=0") + " (записана, не проведена)");
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = "Документы не созданы: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщить(ТекстОшибки);
		ТекстСообщения = ТекстОшибки;
		Возврат;
	КонецПопытки;

	// Защита от повторного создания тех же документов: для нового создания файл нужно загрузить заново
	ТекстJSON = "";
	ТекстСообщения = "Создано расходных накладных: " + Накладные.Количество() + Символы.ПС + СтрСоединить(Протокол, Символы.ПС);
	Сообщить("Создано расходных накладных: " + Накладные.Количество());

КонецПроцедуры

// Строгий поиск элемента справочника по наименованию: ошибка, если элемент
// не найден или найдено несколько элементов с таким наименованием.
&НаСервереБезКонтекста
Процедура НайтиПоНаименованию(ИмяСправочника, Наименование, Найденные, Ошибки)

	Ключ = ИмяСправочника + "|" + Наименование;
	Если Найденные[Ключ] <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	МетаданныеСправочника = Метаданные.Справочники[ИмяСправочника];
	Если ПустаяСтрока(Наименование) Тогда
		ТекстОшибки = "Не заполнено наименование (справочник """ + МетаданныеСправочника.Синоним + """).";
		Если Ошибки.Найти(ТекстОшибки) = Неопределено Тогда
			Ошибки.Добавить(ТекстОшибки);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК Т
	|ГДЕ
	|	Т.Наименование = &Наименование
	|	И НЕ Т.ПометкаУдаления";
	Если МетаданныеСправочника.Иерархический
		И МетаданныеСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И НЕ Т.ЭтоГруппа";
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		Ошибки.Добавить("Не найден элемент справочника """ + МетаданныеСправочника.Синоним + """: " + Наименование);
		Возврат;
	КонецЕсли;
	Ссылка = Выборка.Ссылка;
	Если Выборка.Следующий() Тогда
		Ошибки.Добавить("Несколько совпадений в справочнике """ + МетаданныеСправочника.Синоним + """: " + Наименование);
		Возврат;
	КонецЕсли;

	Найденные.Вставить(Ключ, Ссылка);

КонецПроцедуры

// Заполняет новую расходную накладную по объекту JSON. Номер не заполняется:
// его присвоит платформа (автонумерация) при записи.
&НаСервереБезКонтекста
Функция НоваяРасходнаяНакладная(ИсходныйДок, Найденные)

	Док = Документы.РасходнаяНакладная.СоздатьДокумент();
	Док.Дата = XMLЗначение(Тип("Дата"), ИсходныйДок.ДатаДокумента);

	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ВидОперации", Перечисления.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю);
	ДанныеЗаполнения.Вставить("Организация", Найденные["Организации|" + ИсходныйДок.Организация]);
	ДанныеЗаполнения.Вставить("Контрагент", Найденные["Контрагенты|" + ИсходныйДок.Контрагент]);
	ДанныеЗаполнения.Вставить("СтруктурнаяЕдиница", Найденные["СтруктурныеЕдиницы|" + ИсходныйДок.Склад]);

	// Заполнение по умолчанию средствами УНФ (валюта, курс, налогообложение, ответственный и т.д.)
	Док.Заполнить(ДанныеЗаполнения);
	ЗаполнитьЗначенияСвойств(Док, ДанныеЗаполнения);
	Док.Дата = XMLЗначение(Тип("Дата"), ИсходныйДок.ДатаДокумента);

	Если Не ЗначениеЗаполнено(Док.Договор) Тогда
		Док.Договор = Справочники.ДоговорыКонтрагентов.ПоДокументуКонтрагентуОрганизацииИВидуОперации(
			Док, Док.Контрагент, Док.Организация, Док.ВидОперации);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Док.Договор) Тогда
		Док.Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Док.Контрагент);
	КонецЕсли;

	ВидСтавкиОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док.Организация, "ВидСтавкиНДСПоУмолчанию");
	Для Каждого Позиция Из ИсходныйДок.Товары Цикл

		Номенклатура = Найденные["Номенклатура|" + Позиция.Номенклатура];

		СтрокаТЧ = Док.Запасы.Добавить();
		СтрокаТЧ.Номенклатура = Номенклатура;
		СтрокаТЧ.ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
		СтрокаТЧ.Количество = Позиция.Количество;
		СтрокаТЧ.Сумма = Позиция.Сумма;
		СтрокаТЧ.Цена = ?(СтрокаТЧ.Количество = 0, 0, Окр(СтрокаТЧ.Сумма / СтрокаТЧ.Количество, 2));

		Если Док.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС Тогда
			ВидСтавки = ?(ЗначениеЗаполнено(Номенклатура.ВидСтавкиНДС), Номенклатура.ВидСтавкиНДС, ВидСтавкиОрганизации);
			СтрокаТЧ.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(ВидСтавки, Док.Дата);
			Ставка = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(СтрокаТЧ.СтавкаНДС);
		Иначе
			СтрокаТЧ.СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьСтавкуНДСБезНДС();
			Ставка = 0;
		КонецЕсли;

		СтрокаТЧ.СуммаНДС = ?(Док.СуммаВключаетНДС,
			СтрокаТЧ.Сумма - СтрокаТЧ.Сумма / ((Ставка + 100) / 100),
			СтрокаТЧ.Сумма * Ставка / 100);
		СтрокаТЧ.Всего = СтрокаТЧ.Сумма + ?(Док.СуммаВключаетНДС, 0, СтрокаТЧ.СуммаНДС);

	КонецЦикла;

	Док.СуммаДокумента = Док.Запасы.Итог("Всего");

	Возврат Док;

КонецФункции

#КонецОбласти
